# Connection string for the development database (used by the app and by Alembic).
DATABASE_URL=postgresql+psycopg://lesebuddy:lesebuddy@localhost:5432/lesebuddy

# Connection string for the dedicated test database, used only by the pytest suite.
TEST_DATABASE_URL=postgresql+psycopg://lesebuddy:lesebuddy@localhost:5432/lesebuddy_test

# Session cookie: must be true wherever the app is served over https. False is correct for
# local http development.
SESSION_COOKIE_SECURE=false

# How long a login session stays valid without being used.
SESSION_DURATION_DAYS=30

# Keys the HMAC used to hash email verification codes. The default below is fine for local
# dev/CI but MUST be overridden with a long random value in any real deployment — never commit
# a real secret here.
SECRET_KEY=dev-only-insecure-secret-change-in-production

# SMTP settings for sending verification emails. Defaults point at the Mailpit service in
# docker-compose.yml (web UI at http://localhost:8025) — no auth, no TLS, nothing to configure
# for local dev. Tests never touch SMTP; they use an in-memory fake sender.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM="LeseBuddy <noreply@lesebuddy.local>"

# Email verification code lifecycle.
VERIFICATION_CODE_TTL_MINUTES=15
VERIFICATION_CODE_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_RESEND_HOURLY_CAP=5

# An unverified account older than this is considered expired: registering again with its
# username or email deletes it (and its sessions/codes) and claims the slot.
UNVERIFIED_ACCOUNT_TTL_HOURS=24

# DeepL API Free plan key (https://www.deepl.com/your-account/keys). Leave empty to run
# without translations — the app still starts; translation requests return a clear
# "not configured" error instead of failing. Never commit a real value.
DEEPL_API_KEY=

# DeepL target-language code used when a user has no stored preference yet.
TRANSLATION_DEFAULT_LANGUAGE=EN-US

# Per-user cap on non-cached (real, billed) translation requests per hour. Cached hits never
# count toward this.
TRANSLATION_RATE_LIMIT_PER_HOUR=60

# How long a cached DeepL usage snapshot is trusted before re-checking the monthly quota.
TRANSLATION_USAGE_CHECK_INTERVAL_SECONDS=300

# Above this fraction of the monthly character quota (DeepL Free: 500,000/month), degrade
# translation with a warning instead of a hard failure.
TRANSLATION_USAGE_WARN_THRESHOLD=0.9
